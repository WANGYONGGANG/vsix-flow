{
	"name": "leek-fund",
	"displayName": "LeekFund",
	"description": "无缝融合的跟盘体验，在你让 AI 专注于写代码的同时，它在后台实时且隐蔽地追踪着市场，绝不打断你的任何工作流。",
	"version": "4.3.2",
	"author": "Nicky Lao <giscafer@outlook.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/LeekHub/leek-fund"
	},
	"license": "BSD-3-Clause",
	"keywords": [
		"stock",
		"fund",
		"LeekFund Pro",
		"LeekHub",
		"LeekFund",
		"股票",
		"基金",
		"韭菜盒子"
	],
	"publisher": "giscafer",
	"icon": "resources/logo.png",
	"engines": {
		"vscode": "^1.100.0"
	},
	"enableProposedAPI": false,
	"capabilities": {
		"uriHandler": true
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:leek-fund.refreshStock",
		"onCommand:leek-fund.refreshFund",
		"onView:leekFundView.fund",
		"onView:leekFundView.stock",
		"onView:leekFundView.binance",
		"onView:leekFundView.forex",
		"onView:leekFundView.home",
		"onView:leekFundView.agent",
		"onCommand:leek-fund.openLeekAgent",
		"onCommand:leek-fund.toggleStatusBarIconVisibility",
		"onCommand:leek-fund.locateWatchlist"
	],
	"main": "./out/extension.js",
	"contributes": {
		"chatParticipants": [
			{
				"id": "leek-fund.leek",
				"name": "leek",
				"fullName": "LeekAgent",
				"description": "解读行情与资讯、整理自选上下文（不提供投资建议）",
				"isSticky": true,
				"commands": [
					{
						"name": "summary",
						"description": "摘要今日快讯要点"
					},
					{
						"name": "portfolio",
						"description": "自选与持仓成本概览"
					},
					{
						"name": "explain",
						"description": "解读当前标的公开信息"
					}
				]
			}
		],
		"languageModelTools": [
			{
				"name": "leek_get_watchlist",
				"displayName": "Leek 自选概览",
				"toolReferenceName": "watchlist",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取 LeekFund 股票与基金自选列表及分组概览",
				"inputSchema": {
					"type": "object",
					"properties": {}
				}
			},
			{
				"name": "leek_get_quote",
				"displayName": "Leek 行情",
				"toolReferenceName": "quote",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取自选中的股票或基金实时行情",
				"inputSchema": {
					"type": "object",
					"properties": {
						"code": {
							"type": "string",
							"description": "标的代码"
						},
						"type": {
							"type": "string",
							"description": "stock 或 fund"
						}
					},
					"required": [
						"code"
					]
				}
			},
			{
				"name": "leek_get_holdings_cost",
				"displayName": "Leek 持仓成本",
				"toolReferenceName": "holdings",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取用户自报的持仓成本与盈亏快照",
				"inputSchema": {
					"type": "object",
					"properties": {}
				}
			},
			{
				"name": "leek_get_flash_news",
				"displayName": "Leek 快讯",
				"toolReferenceName": "flashnews",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取金十当日快讯摘录",
				"inputSchema": {
					"type": "object",
					"properties": {
						"limit": {
							"type": "number",
							"description": "条数上限"
						}
					}
				}
			},
			{
				"name": "leek_get_stock_history",
				"displayName": "Leek 历史日线",
				"toolReferenceName": "history",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取股票前复权日线 CSV 片段",
				"inputSchema": {
					"type": "object",
					"properties": {
						"code": {
							"type": "string",
							"description": "股票代码"
						}
					},
					"required": [
						"code"
					]
				}
			},
			{
				"name": "leek_get_sector_heat",
				"displayName": "Leek 板块热度",
				"toolReferenceName": "sector",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取韭菜中心板块行情近期热门与行业概念净流入概览",
				"inputSchema": {
					"type": "object",
					"properties": {}
				}
			},
			{
				"name": "leek_get_sector_board_quote",
				"displayName": "Leek 板块指数行情",
				"toolReferenceName": "sectorboard",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取东方财富板块指数（BK 码）实时行情与成分股数量",
				"inputSchema": {
					"type": "object",
					"properties": {
						"code": {
							"type": "string",
							"description": "板块 BK 码，如 bk1158 或 BK1158"
						}
					},
					"required": [
						"code"
					]
				}
			},
			{
				"name": "leek_get_community_mentions",
				"displayName": "Leek 社区讨论",
				"toolReferenceName": "community",
				"canBeReferencedInPrompt": true,
				"modelDescription": "获取韭研公社相关讨论摘录",
				"inputSchema": {
					"type": "object",
					"properties": {
						"keyword": {
							"type": "string",
							"description": "关键词或股票名称"
						}
					},
					"required": [
						"keyword"
					]
				}
			},
			{
				"name": "leek_open_chart",
				"displayName": "Leek 打开图表",
				"toolReferenceName": "chart",
				"canBeReferencedInPrompt": false,
				"modelDescription": "打开股票或基金走势 Webview",
				"inputSchema": {
					"type": "object",
					"properties": {
						"code": {
							"type": "string"
						},
						"type": {
							"type": "string",
							"description": "fund 打开基金走势"
						}
					},
					"required": [
						"code"
					]
				}
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "leekFundMenu",
					"title": "LeekFund",
					"icon": "resources/leekfund.svg"
				}
			],
			"panel": [
				{
					"id": "leekFundNewsPanel",
					"title": "LeekFund News",
					"icon": "resources/leekfund.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "leekFundAgent",
					"title": "LeekAgent",
					"icon": "resources/leekfund.svg"
				}
			]
		},
		"views": {
			"leekFundAgent": [
				{
					"id": "leekFundView.agent",
					"type": "webview",
					"name": "LeekAgent"
				}
			],
			"leekFundNewsPanel": [
				{
					"id": "leekFundView.news",
					"type": "webview",
					"name": "LeekFund News"
				}
			],
			"leekFundMenu": [
				{
					"id": "leekFundView.home",
					"type": "webview",
					"name": "Home"
				},
				{
					"id": "leekFundView.stock",
					"name": "Stock"
				},
				{
					"id": "leekFundView.fund",
					"name": "Fund"
				},
				{
					"id": "leekFundView.binance",
					"name": "Binance",
					"visibility": "hidden"
				},
				{
					"id": "leekFundView.forex",
					"name": "Forex",
					"visibility": "hidden"
				}
			]
		},
		"commands": [
			{
