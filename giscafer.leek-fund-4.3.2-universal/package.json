		"obfuscate:out": "node ./scripts/obfuscate-out.js",
		"obfuscate:template": "node ./scripts/obfuscate-template-html.js",
		"postcompile": "yarn --cwd ./template-packages/leek-center run build",
		"lint": "eslint src --fix --ext ts  --ignore-path .gitignore",
		"watch": "tsc -watch -p ./",
		"pretest": "yarn run lint && yarn run compile",
		"test": "node ./out/_test/runTest.js",
		"deploy": "node ./scripts/run-vsce-secure.js publish",
		"package": "node ./scripts/run-vsce-secure.js package",
		"commitmsg": "commitlint -e $GIT_PARAMS",
		"release": "standard-version"
	},
	"config": {
