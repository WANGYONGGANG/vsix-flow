.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# JetBrains IDE（WebStorm、IntelliJ 等）
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

