{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vsix",
  "main": "cloudflare-worker/worker.js",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "h5/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}